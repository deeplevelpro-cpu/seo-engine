                <h2>YOUR RESULT</h2>
                <p>Your AI generated result will appear here</p>
              </div>

              <button
                className="copy-btn"
                onClick={copyResult}
                disabled={!result}
              >
                📋 Copy Result
              </button>

            </div>

            <div className={`result-box ${result ? "has-result" : ""}`}>

              {result ? (
                <pre>{result}</pre>
