"use client";

import { useState } from "react";
import { useParams } from "next/navigation";
import toolsData from "@/data/tools";

export default function ToolPage() {
  const params = useParams();
  const slug = params.slug as string;

  const [text, setText] = useState("");
  const [result, setResult] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const tool = toolsData[slug as keyof typeof toolsData];

  if (!tool) {
    return (
      <main className="not-found-page">
        <div className="not-found-card">
          <div className="not-found-icon">⚡</div>
          <h1>Tool Not Found</h1>
          <p>The requested tool could not be found.</p>
          <a href="/tools">← Browse All Tools</a>
        </div>
      </main>
    );
  }

  const runAI = async () => {
    if (!text.trim()) {
      setError("Please enter some content first.");
      return;
    }

    setLoading(true);
    setError("");
    setResult("");

    try {
      const res = await fetch("/api/ai", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          prompt: `You are a professional ${tool.title}.
${tool.description}

Analyze the user's input and provide a useful, accurate and professional result.

User input:
${text}`,
        }),
      });

      const data = await res.json();

      if (!res.ok) {
        setError(
          data?.error?.message ||
            "AI service is temporarily unavailable. Please try again later."
        );
        return;
      }

      setResult(data.result || "No result was generated.");
    } catch {
      setError("Unable to connect to the AI service.");
    } finally {
      setLoading(false);
    }
  };

  const clearAll = () => {
    setText("");
    setResult("");
    setError("");
  };

  const copyResult = async () => {
    if (!result) return;

    try {
      await navigator.clipboard.writeText(result);
    } catch {}
  };

  return (
    <>
      <main className="tool-page">

        {/* Background effects */}
        <div className="bg-glow bg-glow-one" />
        <div className="bg-glow bg-glow-two" />
        <div className="grid-bg" />

        {/* NAVBAR */}
        <nav className="tool-nav">
          <a href="/" className="brand">
            <span className="brand-icon">⚡</span>
            <span>AI TOOL <b>ENGINE</b></span>
          </a>

          <div className="nav-links">
            <a href="/">Home</a>
            <a href="/tools" className="active">Tools</a>
            <a href="/blog">Blog</a>
            <a href="/contact">Contact</a>
          </div>

          <a href="/tools" className="all-tools-btn">
            ▦ &nbsp; All 1000+ Tools
          </a>
        </nav>

        <div className="tool-container">

          {/* BREADCRUMB */}
          <div className="breadcrumb">
            <a href="/">Home</a>
            <span>›</span>
            <a href="/tools">Tools</a>
            <span>›</span>
            <strong>{tool.title}</strong>
          </div>

          {/* HERO */}
          <section className="hero">

            <div className="tool-badge">
              <span className="green-dot" />
              FREE ONLINE AI TOOL
            </div>

            <h1>{tool.title}</h1>

            <p className="hero-description">
              {tool.description}. Get fast, professional results with our
              powerful online AI tool.
            </p>

            <div className="hero-badges">
              <span>⚡ 100% FREE</span>
              <span>🚀 INSTANT RESULTS</span>
              <span>🛡️ SIMPLE & EASY</span>
            </div>

          </section>

          {/* INPUT CARD */}
          <section className="tool-card input-card">

            <div className="card-heading">
              <div className="heading-icon purple">✎</div>

              <div>
                <h2>YOUR INPUT</h2>
                <p>Enter your content below and let AI do the magic ✨</p>
              </div>

              <div className="character-count">
                {text.length.toLocaleString()} Characters
              </div>
            </div>

            <textarea
              value={text}
              onChange={(e) => setText(e.target.value)}
              placeholder="Paste your content here..."
              className="tool-textarea"
            />

            <div className="input-actions">

              <button
                className="clear-btn"
                onClick={clearAll}
              >
                🗑 Clear All
              </button>

              <button
                className="generate-btn"
                onClick={runAI}
                disabled={loading}
              >
                {loading ? "⏳ PROCESSING..." : "🚀 GENERATE RESULT"}
              </button>

              <span className="ai-powered">
                ✨ AI Powered
              </span>

            </div>

            {error && (
              <div className="error-box">
                ⚠️ {error}
              </div>
            )}

          </section>

