export const breadcrumbSchemaGenerator: ToolHandler = ({ text }) => {
  const items = text
    .split(">")
    .map((item) => item.trim())
    .filter(Boolean);

  const names =
    items.length > 0
      ? items
      : ["Home", "Category", "Page"];

  const itemListElement = names.map((name, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name,
  }));

  const schema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement,
  };

  return {
    title: "Breadcrumb Schema",
    content: JSON.stringify(schema, null, 2),
  };
};

