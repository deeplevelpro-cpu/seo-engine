    ].join("\n"),
  };
};

export const metaTagGenerator: ToolHandler = ({ text }) => {
  const lines = cleanText(text)
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  const title = lines[0] || "Your Page Title";
  const description =
    lines.slice(1).join(" ") ||
    "Your page description";

  return {
    title: "Meta Tags",
    content: [
      `<title>${title}</title>`,
      `<meta name="description" content="${description}">`,
    ].join("\n"),
  };
};

