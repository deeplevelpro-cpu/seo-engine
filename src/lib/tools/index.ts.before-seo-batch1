import type { ToolHandler } from "./types";

import {
  wordCounter,
  characterCounter,
  sentenceCounter,
  textReverser,
  textCaseConverter,
  textToSlug,
  removeExtraSpaces,
  randomStringGenerator,
  passwordGenerator,
  keywordDensityChecker,
} from "./handlers";

const unavailableTool: ToolHandler = ({ text }) => {
  const clean = text.trim();

  if (!clean) {
    return {
      title: "No Input",
      content: "Please enter some content first.",
    };
  }

  const words = clean.split(/\s+/).filter(Boolean);

  return {
    title: "Tool Result",
    content: [
      `Words: ${words.length}`,
      `Characters: ${clean.length}`,
      "",
      "This tool is ready for its dedicated processor.",
    ].join("\n"),
  };
};

export const toolRegistry: Record<string, ToolHandler> = {
  "word-counter": wordCounter,
  "character-counter": characterCounter,
  "sentence-counter": sentenceCounter,
  "text-reverser": textReverser,
  "text-case-converter": textCaseConverter,
  "text-to-slug": textToSlug,
  "remove-extra-spaces": removeExtraSpaces,
  "random-string-generator": randomStringGenerator,
  "password-generator": passwordGenerator,
  "keyword-density-checker": keywordDensityChecker,
};

export function getToolHandler(slug: string): ToolHandler {
  return toolRegistry[slug] || unavailableTool;
}
