const unavailableTool: ToolHandler = ({ text }) => {
  const clean = text.trim();

  if (!clean) {
    return {
      title: "No Input",
      content: "Please enter some content first.",
    };
  }

  const words = clean.split(/\s+/).filter(Boolean);

  return {
    title: "Tool Result",
    content: [
      `Words: ${words.length}`,
      `Characters: ${clean.length}`,
      "",
      "This tool is ready for its dedicated processor.",
    ].join("\n"),
  };
};

