export const passwordStrengthChecker: ToolHandler = ({ text }) => {
  const password = text;

  if (!password) {
    return {
      title: "Password Strength Checker",
      content: "Please enter a password.",
    };
  }

  let score = 0;

  if (password.length >= 8) score++;
  if (password.length >= 12) score++;
  if (/[a-z]/.test(password)) score++;
  if (/[A-Z]/.test(password)) score++;
  if (/[0-9]/.test(password)) score++;
  if (/[^A-Za-z0-9]/.test(password)) score++;

  let strength = "Very Weak";

  if (score >= 6) strength = "Very Strong";
  else if (score >= 5) strength = "Strong";
  else if (score >= 4) strength = "Moderate";
  else if (score >= 2) strength = "Weak";

  return {
    title: "Password Strength Check",
    content: [
      `Length: ${password.length}`,
      `Score: ${score}/6`,
      `Strength: ${strength}`,
    ].join("\n"),
  };
};

export const randomNumberGenerator: ToolHandler = ({ text }) => {
  const input = text.trim();
  const parts = input.split(/[\s,]+/).filter(Boolean);

  let min = 1;
  let max = 100;

  if (parts.length >= 2) {
    const parsedMin = Number(parts[0]);
    const parsedMax = Number(parts[1]);

    if (
      Number.isFinite(parsedMin) &&
      Number.isFinite(parsedMax) &&
      parsedMin <= parsedMax
    ) {
      min = Math.ceil(parsedMin);
      max = Math.floor(parsedMax);
    }
  }

  const value =
    Math.floor(Math.random() * (max - min + 1)) + min;

  return {
    title: "Random Number Generator",
    content: `Random number between ${min} and ${max}: ${value}`,
  };
};

export const hashGenerator: ToolHandler = ({ text }) => {
  const crypto = require("crypto");
  const value = text;

  if (!value) {
    return {
      title: "Hash Generator",
      content: "Please enter text to hash.",
    };
  }

  const hash = crypto
    .createHash("sha256")
    .update(value, "utf8")
    .digest("hex");

  return {
    title: "Hash Generator",
    content: hash,
  };
};

export const md5HashGenerator: ToolHandler = ({ text }) => {
  const crypto = require("crypto");
  const value = text;

  if (!value) {
    return {
      title: "MD5 Hash Generator",
      content: "Please enter text to hash.",
    };
  }

  const hash = crypto
    .createHash("md5")
    .update(value, "utf8")
    .digest("hex");

  return {
    title: "MD5 Hash Generator",
    content: hash,
  };
};

