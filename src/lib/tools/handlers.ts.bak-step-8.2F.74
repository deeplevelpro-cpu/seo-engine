export const queryStringParser: ToolHandler = ({ text }) => {
  const input = text.trim();

  if (!input) {
    return {
      title: "Query String Parser",
      content: "Please enter a query string or URL.",
    };
  }

  try {
    const query = input.includes("?")
      ? new URL(input).searchParams
      : new URLSearchParams(input.replace(/^\?/, ""));

    const entries = Array.from(query.entries());

    return {
      title: "Query String Parser",
      content: entries.length
        ? entries.map(([key, value]) => `${key}: ${value}`).join("\n")
        : "No query parameters found.",
    };
  } catch {
    return {
      title: "Query String Parser",
      content: "Invalid query string or URL.",
    };
  }
};

export const queryStringBuilder: ToolHandler = ({ text }) => {
  const input = text.trim();

  if (!input) {
    return {
      title: "Query String Builder",
      content: "Please provide key=value pairs, one per line.",
    };
  }

  const params = new URLSearchParams();

  for (const line of input.split(/\r?\n/)) {
    const trimmed = line.trim();
    if (!trimmed) continue;

    const separator = trimmed.indexOf("=");

    if (separator === -1) {
      params.set(trimmed, "");
    } else {
      const key = trimmed.slice(0, separator).trim();
      const value = trimmed.slice(separator + 1).trim();

      if (key) {
        params.set(key, value);
      }
    }
  }

  const result = params.toString();

  return {
    title: "Query String Builder",
    content: result ? `?${result}` : "No valid parameters found.",
  };
};

export const utmUrlBuilder: ToolHandler = ({ text }) => {
  const raw = text.trim();

  if (!raw) {
    return {
      title: "UTM URL Builder",
      content: "Please enter a URL first.",
    };
  }

  try {
    const url = new URL(raw);

    const params = new URLSearchParams({
      utm_source: "google",
      utm_medium: "organic",
      utm_campaign: "seo",
    });

    url.search = params.toString();

    return {
      title: "UTM URL Builder",
      content: url.toString(),
    };
  } catch {
    return {
      title: "UTM URL Builder",
      content: "Invalid URL. Please enter a complete URL such as https://example.com/page.",
    };
  }
};

export const httpStatusCodeLookup: ToolHandler = ({ text }) => {
  const code = Number.parseInt(text.trim(), 10);

  const statuses: Record<number, string> = {
    100: "Continue",
    101: "Switching Protocols",
    200: "OK",
    201: "Created",
    202: "Accepted",
    204: "No Content",
    301: "Moved Permanently",
    302: "Found",
    304: "Not Modified",
    307: "Temporary Redirect",
    308: "Permanent Redirect",
    400: "Bad Request",
    401: "Unauthorized",
    403: "Forbidden",
    404: "Not Found",
    405: "Method Not Allowed",
    408: "Request Timeout",
    409: "Conflict",
    410: "Gone",
    413: "Content Too Large",
    415: "Unsupported Media Type",
    429: "Too Many Requests",
    500: "Internal Server Error",
    501: "Not Implemented",
    502: "Bad Gateway",
    503: "Service Unavailable",
    504: "Gateway Timeout",
  };

  if (!Number.isInteger(code) || code < 100 || code > 599) {
    return {
      title: "HTTP Status Code Lookup",
      content: "Please enter a valid HTTP status code between 100 and 599.",
    };
  }

  return {
    title: "HTTP Status Code Lookup",
    content: statuses[code] ?? `HTTP status code ${code}`,
  };
};

export const mimeTypeLookup: ToolHandler = ({ text }) => {
  const input = text.trim().toLowerCase();

  const mimeTypes: Record<string, string> = {
    html: "text/html",
    htm: "text/html",
    css: "text/css",
    js: "text/javascript",
    mjs: "text/javascript",
    json: "application/json",
    xml: "application/xml",
    csv: "text/csv",
    txt: "text/plain",
    pdf: "application/pdf",
    zip: "application/zip",
    png: "image/png",
    jpg: "image/jpeg",
    jpeg: "image/jpeg",
    gif: "image/gif",
    webp: "image/webp",
    svg: "image/svg+xml",
    mp3: "audio/mpeg",
    mp4: "video/mp4",
  };

  const extension = input.replace(/^\./, "").split(/[\/\\]/).pop() ?? input;
  const mime = mimeTypes[extension];

  return {
    title: "MIME Type Lookup",
    content: mime
      ? `${extension}: ${mime}`
      : `No MIME type found for: ${input}`,
  };
};

export const userAgentParser: ToolHandler = ({ text }) => {
  const ua = text.trim();

  if (!ua) {
    return {
      title: "User Agent Parser",
      content: "Please enter a user agent string.",
    };
  }

  let browser = "Unknown";
  let operatingSystem = "Unknown";
  let device = "Desktop";

  if (/Edg\//i.test(ua)) browser = "Microsoft Edge";
  else if (/Chrome\//i.test(ua)) browser = "Google Chrome";
  else if (/Firefox\//i.test(ua)) browser = "Mozilla Firefox";
  else if (/Safari\//i.test(ua) && !/Chrome\//i.test(ua)) browser = "Safari";

  if (/Windows/i.test(ua)) operatingSystem = "Windows";
  else if (/Android/i.test(ua)) {
    operatingSystem = "Android";
    device = "Mobile";
  } else if (/iPhone|iPad/i.test(ua)) {
    operatingSystem = /iPad/i.test(ua) ? "iPadOS" : "iOS";
    device = /iPad/i.test(ua) ? "Tablet" : "Mobile";
  } else if (/Mac OS X/i.test(ua)) {
    operatingSystem = "macOS";
  } else if (/Linux/i.test(ua)) {
    operatingSystem = "Linux";
  }

  return {
    title: "User Agent Parser",
    content: [
      `Browser: ${browser}`,
      `Operating system: ${operatingSystem}`,
      `Device: ${device}`,
      `User agent: ${ua}`,
    ].join("\n"),
  };
};

export const domainNameParser: ToolHandler = ({ text }) => {
  const raw = text.trim();

  if (!raw) {
    return {
      title: "Domain Name Parser",
      content: "Please enter a domain or URL.",
    };
  }

  try {
    const normalized = /^https?:\/\//i.test(raw)
      ? raw
      : `https://${raw}`;

    const url = new URL(normalized);
    const hostname = url.hostname;

    const parts = hostname.split(".").filter(Boolean);
    const tld = parts.length ? parts[parts.length - 1] : "";
    const domain = parts.length >= 2 ? parts[parts.length - 2] : hostname;
    const subdomain =
      parts.length > 2 ? parts.slice(0, -2).join(".") : "(none)";

    return {
      title: "Domain Name Parser",
      content: [
        `Hostname: ${hostname}`,
        `Domain: ${domain}`,
        `TLD: .${tld}`,
        `Subdomain: ${subdomain}`,
      ].join("\n"),
    };
  } catch {
    return {
      title: "Domain Name Parser",
      content: "Invalid domain or URL.",
    };
  }
};

