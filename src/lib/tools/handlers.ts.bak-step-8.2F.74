export const xmlFormatter: ToolHandler = ({ text }) => {
  const input = text.trim();

  if (!input) {
    return {
      title: "XML Formatter",
      content: "Please provide XML.",
    };
  }

  const formatted = input
    .replace(/>\s*</g, "><")
    .replace(/></g, ">\n<")
    .split("\n")
    .map((line, index, lines) => {
      let depth = 0;

      for (let i = 0; i < index; i++) {
        const value = lines[i].trim();

        if (
          /^<[^/!?][^>]*>$/.test(value) &&
          !/<\/[^>]+>$/.test(value)
        ) {
          depth++;
        }

        if (/^<\/[^>]+>$/.test(value)) {
          depth = Math.max(0, depth - 1);
        }
      }

      const current = line.trim();

      if (/^<\/[^>]+>/.test(current)) {
        depth = Math.max(0, depth - 1);
      }

      const result = "  ".repeat(depth) + current;

      return result;
    })
    .join("\n");

  return {
    title: "XML Formatter",
    content: formatted,
  };
};

export const xmlValidator: ToolHandler = ({ text }) => {
  const input = text.trim();

  if (!input) {
    return {
      title: "XML Validator",
      content: "Valid XML: No\nError: Empty XML input.",
    };
  }

  const hasRoot = /^<([A-Za-z_][\w:.-]*)(?:\s[^>]*)?>[\s\S]*<\/\1>\s*$/.test(
    input
  );

  const hasSelfClosingRoot =
    /^<([A-Za-z_][\w:.-]*)(?:\s[^>]*)?\/>\s*$/.test(input);

  return {
    title: "XML Validator",
    content: hasRoot || hasSelfClosingRoot
      ? "Valid XML: Yes"
      : "Valid XML: No\nError: XML root structure appears invalid.",
  };
};

export const cssFormatter: ToolHandler = ({ text }) => {
  const input = text.trim();

  if (!input) {
    return {
      title: "CSS Formatter",
      content: "Please provide CSS.",
    };
  }

  const formatted = input
    .replace(/\s+/g, " ")
    .replace(/\s*{\s*/g, " {\n  ")
    .replace(/;\s*/g, ";\n  ")
    .replace(/\s*}\s*/g, "\n}\n")
    .replace(/\n\s*\n/g, "\n")
    .trim();

  return {
    title: "CSS Formatter",
    content: formatted,
  };
};

export const javascriptFormatter: ToolHandler = ({ text }) => {
  const input = text.trim();

  if (!input) {
    return {
      title: "JavaScript Formatter",
      content: "Please enter JavaScript code.",
    };
  }

  let formatted = input
    .replace(/\s*{\s*/g, " {\n  ")
    .replace(/;\s*/g, ";\n  ")
    .replace(/\s*}\s*/g, "\n}")
    .replace(/\n\s*\n/g, "\n");

  formatted = formatted
    .split("\n")
    .map((line) => line.trimEnd())
    .join("\n")
    .trim();

  return {
    title: "JavaScript Formatter",
    content: formatted,
  };
};

export const sqlFormatter: ToolHandler = ({ text }) => {
  const input = text.trim();

  if (!input) {
    return {
      title: "SQL Formatter",
      content: "Please enter SQL.",
    };
  }

  const formatted = input
    .replace(/\s+/g, " ")
    .replace(/\s*(SELECT|FROM|WHERE|GROUP BY|ORDER BY|HAVING|LIMIT|JOIN|LEFT JOIN|RIGHT JOIN|INNER JOIN|OUTER JOIN|UNION)\s*/gi, "\n$1 ")
    .trim();

  return {
    title: "SQL Formatter",
    content: formatted,
  };
};

export const sqlMinifier: ToolHandler = ({ text }) => {
  const input = text.trim();

  if (!input) {
    return {
      title: "SQL Minifier",
      content: "Please enter SQL.",
    };
  }

  const minified = input
    .replace(/--.*$/gm, "")
    .replace(/\s+/g, " ")
    .trim();

  return {
    title: "SQL Minifier",
    content: minified,
  };
};

export const uuidGenerator: ToolHandler = () => {
  const uuid = crypto.randomUUID();

  return {
    title: "UUID Generator",
    content: uuid,
  };
};

export const uuidValidator: ToolHandler = ({ text }) => {
  const input = text.trim();

  const uuidRegex =
    /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

  return {
    title: "UUID Validator",
    content: [
      `UUID: ${input || "(empty)"}`,
      `Valid UUID: ${uuidRegex.test(input) ? "Yes" : "No"}`,
    ].join("\n"),
  };
};

export const unixTimestampConverter: ToolHandler = ({ text }) => {
  const input = text.trim();

  if (!input) {
    return {
      title: "Unix Timestamp Converter",
      content: "Please enter a Unix timestamp.",
    };
  }

  const timestamp = Number(input);

  if (!Number.isFinite(timestamp)) {
    return {
      title: "Unix Timestamp Converter",
      content: "Invalid Unix timestamp.",
    };
  }

  const date = new Date(timestamp * 1000);

  if (Number.isNaN(date.getTime())) {
    return {
      title: "Unix Timestamp Converter",
      content: "Invalid Unix timestamp.",
    };
  }

  return {
    title: "Unix Timestamp Converter",
    content: [
      `Unix timestamp: ${timestamp}`,
      `UTC date: ${date.toISOString()}`,
    ].join("\n"),
  };
};

export const timestampGenerator: ToolHandler = ({ text }) => {
  const input = text.trim();

  const date = input ? new Date(input) : new Date();

  if (Number.isNaN(date.getTime())) {
    return {
      title: "Timestamp Generator",
      content: "Invalid date or time.",
    };
  }

  const timestamp = Math.floor(date.getTime() / 1000);

  return {
    title: "Timestamp Generator",
    content: [
      `Date: ${date.toISOString()}`,
      `Unix timestamp: ${timestamp}`,
    ].join("\n"),
  };
};

export const regexTester: ToolHandler = ({ text, keyword }) => {
  const pattern = (keyword ?? "").trim();

  if (!pattern) {
    return {
      title: "Regex Tester",
      content: "Please provide a regular expression in the keyword field.",
    };
  }

  try {
    const regex = new RegExp(pattern);
    const matches = text.match(regex);

    return {
      title: "Regex Test Result",
      content: [
        `Pattern: ${pattern}`,
        `Matches: ${matches ? matches.length : 0}`,
        `Result: ${regex.test(text) ? "Match found" : "No match"}`,
      ].join("\n"),
    };
  } catch {
    return {
      title: "Regex Test Result",
      content: "Invalid regular expression.",
    };
  }
};

export const regexEscapeTool: ToolHandler = ({ text }) => {
