export const seoSlugGenerator: ToolHandler = ({ text }) => {
  const slug = text
    .trim()
    .toLowerCase()
    .normalize("NFKD")
    .replace(/[^\w\s-]/g, "")
    .replace(/[\s_-]+/g, "-")
    .replace(/^-+|-+$/g, "");

  return {
    title: "SEO Slug",
    content: slug || "example-page",
  };
};

export const seoTitleChecker: ToolHandler = ({ text }) => {
  const title = text.trim();
  const length = title.length;

  let status = "Good";

  if (!title) {
    status = "Missing";
  } else if (length < 30) {
    status = "Too Short";
  } else if (length > 60) {
    status = "Too Long";
  }

  return {
    title: "SEO Title Check",
    content: [
      `Title: ${title || "(empty)"}`,
      `Length: ${length}`,
      `Status: ${status}`,
      "Recommended length: 30-60 characters",
    ].join("\n"),
  };
};

export const metaDescriptionLengthChecker: ToolHandler = ({ text }) => {
  const description = text.trim();
  const length = description.length;

  let status = "Good";

  if (!description) {
    status = "Missing";
  } else if (length < 120) {
    status = "Too Short";
  } else if (length > 160) {
    status = "Too Long";
  }

  return {
    title: "Meta Description Length",
    content: [
      `Description: ${description || "(empty)"}`,
      `Length: ${length}`,
      `Status: ${status}`,
      "Recommended length: 120-160 characters",
    ].join("\n"),
  };
};

export const headingStructureChecker: ToolHandler = ({ text }) => {
  const clean = text.trim();

  if (!clean) {
    return {
      title: "Heading Structure Check",
      content: "Please enter text containing headings.",
    };
  }

  const lines = clean.split(/\r?\n/);

  const headings = lines
    .map((line) => {
      const match = line.match(/^(#{1,6})\s+(.+)$/);
      if (!match) return null;

      return {
        level: match[1].length,
        text: match[2].trim(),
      };
    })
    .filter(Boolean) as { level: number; text: string }[];

  if (!headings.length) {
    return {
      title: "Heading Structure Check",
      content:
        "No Markdown headings found. Use # for H1, ## for H2, ### for H3, and so on.",
    };
  }

  const counts = headings.reduce<Record<number, number>>((acc, heading) => {
    acc[heading.level] = (acc[heading.level] || 0) + 1;
    return acc;
  }, {});

  const issues: string[] = [];

  if (headings[0].level !== 1) {
    issues.push("The first detected heading is not H1.");
  }

  for (let i = 1; i < headings.length; i++) {
    const previous = headings[i - 1].level;
    const current = headings[i].level;

    if (current > previous + 1) {
      issues.push(
        `Heading hierarchy jumps from H${previous} to H${current}.`
      );
    }
  }

  return {
    title: "Heading Structure Check",
    content: [
      `Total headings: ${headings.length}`,
      `H1: ${counts[1] || 0}`,
      `H2: ${counts[2] || 0}`,
      `H3: ${counts[3] || 0}`,
      `H4: ${counts[4] || 0}`,
      `H5: ${counts[5] || 0}`,
      `H6: ${counts[6] || 0}`,
      "",
      issues.length
        ? `Issues:\n- ${issues.join("\n- ")}`
        : "Status: Heading hierarchy looks good.",
    ].join("\n"),
  };
};

export const internalLinkChecker: ToolHandler = ({ text }) => {
  const clean = text.trim();

  if (!clean) {
    return {
      title: "Internal Link Checker",
      content: "Please enter HTML or text containing links.",
    };
  }

  const links = [...clean.matchAll(/<a\b[^>]*href=["']([^"']+)["'][^>]*>/gi)]
    .map((match) => match[1]);

  const internal = links.filter((url) => {
    return (
      url.startsWith("/") ||
      url.startsWith("#") ||
      url.startsWith("./") ||
      url.startsWith("../")
    );
  });

  const external = links.filter((url) => !internal.includes(url));

  return {
    title: "Internal Link Checker",
    content: [
      `Total links found: ${links.length}`,
      `Internal links: ${internal.length}`,
      `External links: ${external.length}`,
      "",
      internal.length
        ? `Internal URLs:\n${internal.map((url) => `- ${url}`).join("\n")}`
        : "No internal links found.",
    ].join("\n"),
  };
};

export const keywordPlacementChecker: ToolHandler = ({ text, keyword }) => {
  const clean = text.trim();
  const target = (keyword || "").trim().toLowerCase();

  if (!clean || !target) {
    return {
      title: "Keyword Placement Check",
      content: "Please provide both content and a target keyword.",
    };
  }

  const lines = clean.split(/\r?\n/);
  const firstParagraph = lines.find((line) => line.trim()) || "";

  const lower = clean.toLowerCase();

  const placements = {
    title:
      lines[0]?.toLowerCase().includes(target) || false,
    firstParagraph: firstParagraph.toLowerCase().includes(target),
    headings: lines.some(
      (line) =>
        /^#{1,6}\s+/.test(line) &&
        line.toLowerCase().includes(target)
    ),
    body: lower.includes(target),
  };

  const occurrences = lower.split(target).length - 1;

  return {
    title: "Keyword Placement Check",
    content: [
      `Keyword: ${keyword}`,
      `Occurrences: ${occurrences}`,
      `Title: ${placements.title ? "Found" : "Not found"}`,
      `First paragraph: ${
        placements.firstParagraph ? "Found" : "Not found"
      }`,
      `Headings: ${placements.headings ? "Found" : "Not found"}`,
      `Body content: ${placements.body ? "Found" : "Not found"}`,
    ].join("\n"),
  };
};

export const paragraphCounter: ToolHandler = ({ text }) => {
  const clean = text.trim();

  if (!clean) {
    return {
      title: "Paragraph Counter",
      content: "Paragraphs: 0",
    };
  }

  const paragraphs = clean
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);

  return {
    title: "Paragraph Counter",
    content: [
      `Paragraphs: ${paragraphs.length}`,
      `Words: ${clean.split(/\s+/).filter(Boolean).length}`,
      `Characters: ${clean.length}`,
    ].join("\n"),
  };
};

export const readingTimeCalculator: ToolHandler = ({ text }) => {
  const clean = text.trim();

  if (!clean) {
    return {
      title: "Reading Time Calculator",
      content: "Reading time: 0 minutes",
    };
  }

  const words = clean.split(/\s+/).filter(Boolean).length;
  const minutes = Math.max(1, Math.ceil(words / 200));

  return {
    title: "Reading Time Calculator",
    content: [
      `Words: ${words}`,
      `Estimated reading time: ${minutes} minute${
        minutes === 1 ? "" : "s"
      }`,
      "Calculation: approximately 200 words per minute.",
    ].join("\n"),
  };
};

export const removeDuplicateLines: ToolHandler = ({ text }) => {
  const lines = text.split(/\r?\n/);

  const seen = new Set<string>();
  const unique: string[] = [];

  for (const line of lines) {
    if (!seen.has(line)) {
      seen.add(line);
      unique.push(line);
    }
  }

  return {
    title: "Duplicate Lines Removed",
    content: [
      `Original lines: ${lines.length}`,
      `Unique lines: ${unique.length}`,
      `Duplicates removed: ${lines.length - unique.length}`,
      "",
      unique.join("\n"),
    ].join("\n"),
  };
};

export const removeEmptyLines: ToolHandler = ({ text }) => {
  const lines = text.split(/\r?\n/);
  const cleaned = lines.filter((line) => line.trim() !== "");

  return {
    title: "Empty Lines Removed",
    content: [
      `Original lines: ${lines.length}`,
      `Remaining lines: ${cleaned.length}`,
      `Empty lines removed: ${lines.length - cleaned.length}`,
      "",
      cleaned.join("\n"),
    ].join("\n"),
  };
};

export const lineCounter: ToolHandler = ({ text }) => {
  if (!text) {
    return {
      title: "Line Counter",
      content: "Lines: 0",
    };
  }

  const lines = text.split(/\r?\n/);

  return {
    title: "Line Counter",
    content: [
      `Lines: ${lines.length}`,
      `Non-empty lines: ${lines.filter((line) => line.trim()).length}`,
      `Empty lines: ${lines.filter((line) => !line.trim()).length}`,
    ].join("\n"),
  };
};

export const wordFrequencyCounter: ToolHandler = ({ text }) => {
  const words = text
    .toLowerCase()
    .match(/[a-z0-9]+(?:['’-][a-z0-9]+)*/gi) || [];

  const frequencies = new Map<string, number>();

  for (const word of words) {
    frequencies.set(word, (frequencies.get(word) || 0) + 1);
  }

  const sorted = [...frequencies.entries()]
    .sort((a, b) => {
      if (b[1] !== a[1]) return b[1] - a[1];
      return a[0].localeCompare(b[0]);
    });

  return {
    title: "Word Frequency",
    content: [
      `Total words: ${words.length}`,
      `Unique words: ${sorted.length}`,
      "",
      sorted
        .slice(0, 20)
        .map(([word, count], index) => `${index + 1}. ${word}: ${count}`)
        .join("\n"),
    ].join("\n"),
  };
};

export const textSorter: ToolHandler = ({ text }) => {
  const lines = text.split(/\r?\n/);

  const sorted = [...lines].sort((a, b) =>
    a.localeCompare(b, undefined, {
      sensitivity: "base",
      numeric: true,
    })
  );

  return {
    title: "Sorted Text",
    content: [
      `Lines sorted: ${lines.length}`,
      "",
      sorted.join("\n"),
    ].join("\n"),
  };
};


export const findAndReplaceText: ToolHandler = ({ text, keyword }) => {
  const input = text || "";
  const parts = (keyword || "").split("=>");
  const find = parts[0]?.trim() || "";
  const replace = parts.slice(1).join("=>").trim();

  if (!find) {
    return {
      title: "Find and Replace",
      content: "Provide the text to find using: find => replace",
    };
  }

  const occurrences = input.split(find).length - 1;
  const output = input.split(find).join(replace);

  return {
    title: "Find and Replace Result",
    content: [
      `Find: ${find}`,
      `Replace: ${replace}`,
      `Occurrences replaced: ${occurrences}`,
      "",
      output,
    ].join("\n"),
  };
};

export const loremIpsumGenerator: ToolHandler = ({ text }) => {
  const requested = Number.parseInt(text.trim(), 10);
  const paragraphs = Math.min(
    10,
    Math.max(1, Number.isFinite(requested) ? requested : 1)
  );

  const base =
    "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.";

  return {
    title: "Lorem Ipsum Generator",
    content: Array.from({ length: paragraphs }, () => base).join("\n\n"),
  };
};

export const textCleaner: ToolHandler = ({ text }) => {
  const cleaned = text
    .replace(/\r\n/g, "\n")
    .replace(/[ \t]+/g, " ")
    .replace(/\n{3,}/g, "\n\n")
    .trim();

  return {
    title: "Text Cleaner",
    content: cleaned,
  };
};

export const duplicateWordFinder: ToolHandler = ({ text }) => {
  const words = text
    .toLowerCase()
    .match(/[a-z0-9']+/g) || [];

  const counts = new Map<string, number>();

  for (const word of words) {
    counts.set(word, (counts.get(word) || 0) + 1);
  }

  const duplicates = [...counts.entries()]
    .filter(([, count]) => count > 1)
    .sort((a, b) => b[1] - a[1]);

  return {
    title: "Duplicate Word Finder",
    content: duplicates.length
      ? duplicates
          .map(([word, count], index) => `${index + 1}. ${word}: ${count}`)
          .join("\n")
      : "No duplicate words found.",
  };
};

export const palindromeChecker: ToolHandler = ({ text }) => {
  const clean = text.toLowerCase().replace(/[^a-z0-9]/g, "");
  const reversed = clean.split("").reverse().join("");
  const isPalindrome = clean.length > 0 && clean === reversed;

  return {
    title: "Palindrome Checker",
    content: [
      `Input: ${text}`,
      `Normalized: ${clean}`,
      `Palindrome: ${isPalindrome ? "Yes" : "No"}`,
    ].join("\n"),
  };
};


