  const schema = {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    name,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Example City",
      addressCountry: "US",
    },
  };

  return {
    title: "Local Business Schema",
    content: JSON.stringify(schema, null, 2),
