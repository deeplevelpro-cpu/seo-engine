import type { ToolHandler } from "./types";

function cleanText(text: string): string {
  return text.trim();
}

function wordsOf(text: string): string[] {
  return cleanText(text).split(/\s+/).filter(Boolean);
}

export const wordCounter: ToolHandler = ({ text }) => {
  const clean = cleanText(text);
  const words = wordsOf(clean);
  const sentences = clean
    ? clean.split(/[.!?]+/).filter((item) => item.trim()).length
    : 0;
  const paragraphs = clean
    ? clean.split(/\n\s*\n/).filter((item) => item.trim()).length
    : 0;
  const readingTime = Math.max(1, Math.ceil(words.length / 200));

  return {
    title: "Word Counter Result",
    content: [
      `Words: ${words.length}`,
      `Characters: ${clean.length}`,
      `Characters without spaces: ${clean.replace(/\s/g, "").length}`,
      `Sentences: ${sentences}`,
      `Paragraphs: ${paragraphs}`,
      `Estimated reading time: ${readingTime} minute${readingTime === 1 ? "" : "s"}`,
    ].join("\n"),
  };
};

export const characterCounter: ToolHandler = ({ text }) => {
  const clean = cleanText(text);

  return {
    title: "Character Counter Result",
    content: [
      `Characters: ${clean.length}`,
      `Characters without spaces: ${clean.replace(/\s/g, "").length}`,
      `Spaces: ${(clean.match(/ /g) || []).length}`,
      `Newlines: ${(clean.match(/\n/g) || []).length}`,
    ].join("\n"),
  };
};

export const sentenceCounter: ToolHandler = ({ text }) => {
  const clean = cleanText(text);

  const sentences = clean
    ? clean
        .split(/[.!?]+/)
        .map((sentence) => sentence.trim())
        .filter(Boolean)
    : [];

  return {
    title: "Sentence Counter Result",
    content: `Sentences: ${sentences.length}`,
  };
};

export const textReverser: ToolHandler = ({ text }) => {
  const clean = text;

  return {
    title: "Reversed Text",
    content: Array.from(clean).reverse().join(""),
  };
};

export const textCaseConverter: ToolHandler = ({ text }) => {
  const clean = text;

  const titleCase = clean.replace(
    /\w\S*/g,
    (word) =>
      word.charAt(0).toUpperCase() +
      word.slice(1).toLowerCase()
  );

  const sentenceCase = clean
    .toLowerCase()
    .replace(/(^\s*\w|[.!?]\s+\w)/g, (match) =>
      match.toUpperCase()
    );

  return {
    title: "Text Case Conversion",
    content: [
      "UPPERCASE:",
      clean.toUpperCase(),
      "",
      "lowercase:",
      clean.toLowerCase(),
      "",
      "Title Case:",
      titleCase,
      "",
      "Sentence Case:",
      sentenceCase,
    ].join("\n"),
  };
};

export const textToSlug: ToolHandler = ({ text }) => {
  const slug = cleanText(text)
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, "")
    .trim()
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-");

  return {
    title: "Generated Slug",
    content: slug,
  };
};

export const removeExtraSpaces: ToolHandler = ({ text }) => {
  const result = text
    .replace(/[ \t]+/g, " ")
    .replace(/\n[ \t]+/g, "\n")
    .replace(/[ \t]+\n/g, "\n")
    .replace(/\n{3,}/g, "\n\n")
    .trim();

  return {
    title: "Cleaned Text",
    content: result,
  };
};

function randomCharacters(
  length: number,
  alphabet: string
): string {
  const values = new Uint32Array(length);

  if (typeof crypto !== "undefined" && crypto.getRandomValues) {
    crypto.getRandomValues(values);
  } else {
    for (let i = 0; i < length; i++) {
      values[i] = Math.floor(Math.random() * 0xffffffff);
    }
  }

  return Array.from(values, (value) =>
    alphabet[value % alphabet.length]
  ).join("");
}

export const randomStringGenerator: ToolHandler = () => {
  const alphabet =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";

  const result = randomCharacters(20, alphabet);

  return {
    title: "Random String",
    content: result,
  };
};

export const passwordGenerator: ToolHandler = () => {
  const lowercase = "abcdefghijklmnopqrstuvwxyz";
  const uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  const numbers = "0123456789";
  const symbols = "!@#$%^&*()-_=+[]{}";

  const required = [
    randomCharacters(1, lowercase),
    randomCharacters(1, uppercase),
    randomCharacters(1, numbers),
    randomCharacters(1, symbols),
  ].join("");

  const remaining = randomCharacters(
    12,
    lowercase + uppercase + numbers + symbols
  );

  const password = Array.from(required + remaining)
    .sort(() => Math.random() - 0.5)
    .join("");

  return {
    title: "Generated Password",
    content: password,
  };
};

export const keywordDensityChecker: ToolHandler = ({
  text,
  keyword,
}) => {
  const clean = cleanText(text);
  const target = cleanText(keyword || "").toLowerCase();
  const words = wordsOf(clean);

  if (!target) {
    return {
      title: "Keyword Density",
      content: "Please enter a keyword to check.",
    };
  }

  const lower = clean.toLowerCase();
  const matches =
    target.length > 0
      ? lower.split(target).length - 1
      : 0;

  const density =
    words.length > 0
      ? ((matches / words.length) * 100).toFixed(2)
      : "0.00";

  return {
    title: "Keyword Density Result",
    content: [
      `Keyword: ${keyword}`,
      `Keyword occurrences: ${matches}`,
      `Total words: ${words.length}`,
      `Keyword density: ${density}%`,
    ].join("\n"),
  };
};

export const keywordFrequencyChecker: ToolHandler = ({
  text,
  keyword,
}) => {
  const clean = cleanText(text);
  const target = cleanText(keyword || "").toLowerCase();

  if (!target) {
    return {
      title: "Keyword Frequency Checker",
      content: "Please enter a keyword to check.",
    };
  }

  const words = wordsOf(clean);
  const lower = clean.toLowerCase();

  const occurrences =
    target.length > 0
      ? lower.split(target).length - 1
      : 0;

  return {
    title: "Keyword Frequency Result",
    content: [
      `Keyword: ${keyword}`,
      `Occurrences: ${occurrences}`,
      `Total words: ${words.length}`,
      `Keyword frequency: ${
        words.length
          ? ((occurrences / words.length) * 100).toFixed(2)
          : "0.00"
      }%`,
    ].join("\n"),
  };
};

export const metaTagGenerator: ToolHandler = ({ text }) => {
  const lines = cleanText(text)
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  const title = lines[0] || "Your Page Title";
  const description =
    lines.slice(1).join(" ") ||
    "Your page description";

  return {
    title: "Meta Tags",
    content: [
      `<title>${title}</title>`,
      `<meta name="description" content="${description}">`,
    ].join("\n"),
  };
};

export const metaDescriptionGenerator: ToolHandler = ({ text }) => {
  const clean = cleanText(text);

  if (!clean) {
    return {
      title: "Meta Description",
      content: "Please enter your topic or page content.",
    };
  }

  const description = clean
    .replace(/\s+/g, " ")
    .slice(0, 155);

  return {
    title: "Generated Meta Description",
    content: description,
  };
};

export const titleTagGenerator: ToolHandler = ({ text }) => {
  const clean = cleanText(text);

  if (!clean) {
    return {
      title: "Title Tag",
      content: "Please enter a topic or keyword.",
    };
  }

  const title =
    clean
      .replace(/\s+/g, " ")
      .trim()
      .slice(0, 60);

  return {
    title: "Generated Title Tag",
    content: title,
  };
};

export const serpSnippetPreview: ToolHandler = ({ text }) => {
  const lines = cleanText(text)
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  const title = (lines[0] || "Your Page Title").slice(0, 60);
  const description = (
    lines.slice(1).join(" ") ||
    "Your meta description"
  ).slice(0, 160);

  return {
    title: "SERP Snippet Preview",
    content: [
      `Title: ${title}`,
      `Title length: ${title.length}`,
      "",
      `Description: ${description}`,
      `Description length: ${description.length}`,
      "",
      "URL: https://example.com/your-page",
    ].join("\n"),
  };
};

export const robotsTxtGenerator: ToolHandler = ({ text }) => {
  const site = cleanText(text).replace(/\/+$/, "");
  const baseUrl = site || "https://example.com";

  return {
    title: "Robots.txt Generator",
    content: [
      "User-agent: *",
      "Allow: /",
      "",
      `Sitemap: ${baseUrl}/sitemap.xml`,
    ].join("\n"),
  };
};

export const sitemapGenerator: ToolHandler = ({ text }) => {
  const lines = cleanText(text)
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  const baseUrl = (lines.shift() || "https://example.com")
    .replace(/\/+$/, "");

  const urls = lines.length ? lines : ["/"];

  const xml = [
    '<?xml version="1.0" encoding="UTF-8"?>',
    '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">',
    ...urls.map((url) => {
      const fullUrl = url.startsWith("http")
        ? url
        : `${baseUrl}${url.startsWith("/") ? "" : "/"}${url}`;

      return `  <url><loc>${fullUrl}</loc></url>`;
    }),
    "</urlset>",
  ].join("\n");

  return {
    title: "XML Sitemap",
    content: xml,
  };
};

export const canonicalUrlGenerator: ToolHandler = ({ text }) => {
  const url = cleanText(text);

  if (!url) {
    return {
      title: "Canonical URL",
      content: "Please enter a page URL.",
    };
  }

  return {
    title: "Canonical URL",
    content: `<link rel="canonical" href="${url}" />`,
  };
};

export const openGraphGenerator: ToolHandler = ({ text }) => {
  const lines = cleanText(text)
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  const title = lines[0] || "Your Page Title";
  const description = lines[1] || "Your page description";
  const url = lines[2] || "https://example.com/page";

  return {
    title: "Open Graph Tags",
    content: [
      `<meta property="og:title" content="${title}" />`,
      `<meta property="og:description" content="${description}" />`,
      `<meta property="og:url" content="${url}" />`,
      `<meta property="og:type" content="website" />`,
    ].join("\n"),
  };
};

export const twitterCardGenerator: ToolHandler = ({ text }) => {
  const lines = cleanText(text)
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  const title = lines[0] || "Your Page Title";
  const description = lines[1] || "Your page description";

  return {
    title: "Twitter Card Tags",
    content: [
      `<meta name="twitter:card" content="summary_large_image" />`,
      `<meta name="twitter:title" content="${title}" />`,
      `<meta name="twitter:description" content="${description}" />`,
    ].join("\n"),
  };
};

export const schemaMarkupGenerator: ToolHandler = ({ text }) => {
  const value = text.trim() || "Example Page";

  const schema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: value,
  };

  return {
    title: "Schema Markup",
    content: JSON.stringify(schema, null, 2),
  };
};

export const faqSchemaGenerator: ToolHandler = ({ text }) => {
  const lines = text
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  const questions = [];

  for (let i = 0; i < lines.length; i += 2) {
    const question = lines[i];
    const answer = lines[i + 1];

    if (!question || !answer) continue;

    questions.push({
      "@type": "Question",
      name: question,
      acceptedAnswer: {
        "@type": "Answer",
        text: answer,
      },
    });
  }

  if (questions.length === 0) {
    questions.push({
      "@type": "Question",
      name: "What is this tool?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "This is an example FAQ answer.",
      },
    });
  }

  const schema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: questions,
  };

  return {
    title: "FAQ Schema",
    content: JSON.stringify(schema, null, 2),
  };
};

export const articleSchemaGenerator: ToolHandler = ({ text }) => {
  const title = text.trim() || "Example Article";

  const schema = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    author: {
      "@type": "Person",
      name: "Author",
    },
  };

  return {
    title: "Article Schema",
    content: JSON.stringify(schema, null, 2),
  };
};

export const breadcrumbSchemaGenerator: ToolHandler = ({ text }) => {
  const items = text
    .split(">")
    .map((item) => item.trim())
    .filter(Boolean);

  const names =
    items.length > 0
      ? items
      : ["Home", "Category", "Page"];

  const itemListElement = names.map((name, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name,
  }));

  const schema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement,
  };

  return {
    title: "Breadcrumb Schema",
    content: JSON.stringify(schema, null, 2),
  };
};

export const localBusinessSchemaGenerator: ToolHandler = ({ text }) => {
