export const hmacGenerator: ToolHandler = ({ text, keyword }) => {
  const crypto = require("crypto");
  const value = text;
  const secret = (keyword ?? "").trim();

  if (!value) {
    return {
      title: "HMAC Generator",
      content: "Please enter text to sign.",
    };
  }

  if (!secret) {
    return {
      title: "HMAC Generator",
      content: "Please provide a secret key in the keyword field.",
    };
  }

  const hmac = crypto
    .createHmac("sha256", secret)
    .update(value, "utf8")
    .digest("hex");

  return {
    title: "HMAC Generator",
    content: hmac,
  };
};


export const secretKeyGenerator: ToolHandler = ({ text }) => {
  const requestedLength = Number.parseInt(text.trim(), 10);
  const length =
    Number.isFinite(requestedLength) && requestedLength >= 16
      ? Math.min(requestedLength, 128)
      : 32;

  const bytes = new Uint8Array(length);
  crypto.getRandomValues(bytes);

  const alphabet =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

  let key = "";

  for (const byte of bytes) {
    key += alphabet[byte % alphabet.length];
  }

  return {
    title: "Secret Key Generator",
    content: `Length: ${length}\nSecret key: ${key}`,
  };
};

export const pinGenerator: ToolHandler = ({ text }) => {
  const requestedLength = Number.parseInt(text.trim(), 10);
  const length =
    Number.isFinite(requestedLength) && requestedLength >= 4
      ? Math.min(requestedLength, 12)
      : 6;

  const digits = new Uint8Array(length);
  crypto.getRandomValues(digits);

  let pin = "";

  for (const byte of digits) {
    pin += String(byte % 10);
  }

  return {
    title: "PIN Generator",
    content: `Length: ${length}\nPIN: ${pin}`,
  };
};

export const imageAltTextGenerator: ToolHandler = ({ text }) => {
  const clean = text.trim();

  if (!clean) {
    return {
      title: "Image Alt Text Generator",
      content: "Please describe the image first.",
    };
  }

  const normalized = clean
    .replace(/\s+/g, " ")
    .replace(/[.!?]+$/g, "");

  const firstChar = normalized.charAt(0).toUpperCase();
  const rest = normalized.slice(1);

  return {
    title: "Image Alt Text Generator",
    content: `Suggested alt text: ${firstChar}${rest}.`,
  };
};

export const imageFilenameGenerator: ToolHandler = ({ text }) => {
  const clean = text
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

  if (!clean) {
    return {
      title: "Image Filename Generator",
      content: "Please provide an image description.",
    };
  }

  return {
    title: "Image Filename Generator",
    content: `${clean}.webp`,
  };
};

export const imageDimensionsChecker: ToolHandler = ({ text }) => {
  const clean = text.trim();

  const match = clean.match(
    /^\s*(\d+)\s*[x×]\s*(\d+)\s*$/i
  );

  if (!match) {
    return {
      title: "Image Dimensions Checker",
      content: "Enter dimensions in WIDTHxHEIGHT format, for example 1920x1080.",
    };
  }

  const width = Number(match[1]);
  const height = Number(match[2]);
  const aspectRatio = width / height;

  return {
    title: "Image Dimensions Checker",
    content: [
      `Width: ${width}px`,
      `Height: ${height}px`,
      `Aspect ratio: ${aspectRatio.toFixed(2)}:1`,
      `Pixels: ${(width * height).toLocaleString()}`,
    ].join("\n"),
  };
};


export const colorPicker: ToolHandler = ({ text }) => {
  const clean = text.trim();

  if (!clean) {
    return {
      title: "Color Picker",
      content: "Enter a HEX color, for example #3498db.",
    };
  }

  const normalized = clean.startsWith("#") ? clean : `#${clean}`;
  const hex = normalized.slice(1);

  if (!/^[0-9a-fA-F]{6}$/.test(hex)) {
    return {
      title: "Color Picker",
      content: "Please enter a valid 6-digit HEX color.",
    };
  }

  const r = Number.parseInt(hex.slice(0, 2), 16);
  const g = Number.parseInt(hex.slice(2, 4), 16);
  const b = Number.parseInt(hex.slice(4, 6), 16);

  return {
    title: "Color Picker",
    content: [
      `HEX: #${hex.toUpperCase()}`,
      `RGB: rgb(${r}, ${g}, ${b})`,
      `Red: ${r}`,
      `Green: ${g}`,
      `Blue: ${b}`,
    ].join("\n"),
  };
};

export const hexToRgbConverter: ToolHandler = ({ text }) => {
  const clean = text.trim().replace(/^#/, "");

  if (!/^[0-9a-fA-F]{6}$/.test(clean)) {
    return {
      title: "HEX to RGB Converter",
      content: "Enter a valid 6-digit HEX color, for example #3498db.",
    };
  }

  const r = Number.parseInt(clean.slice(0, 2), 16);
  const g = Number.parseInt(clean.slice(2, 4), 16);
  const b = Number.parseInt(clean.slice(4, 6), 16);

  return {
    title: "HEX to RGB Converter",
    content: `HEX: #${clean.toUpperCase()}\nRGB: rgb(${r}, ${g}, ${b})`,
  };
};

export const rgbToHexConverter: ToolHandler = ({ text }) => {
  const clean = text.trim();

  const match = clean.match(
    /^\s*(?:rgb\s*\(\s*)?(\d{1,3})\s*[, ]\s*(\d{1,3})\s*[, ]\s*(\d{1,3})\s*\)?\s*$/i
  );

  if (!match) {
    return {
      title: "RGB to HEX Converter",
      content: "Enter RGB values such as 52, 152, 219.",
    };
  }

  const values = match.slice(1, 4).map(Number);

  if (values.some((value) => value < 0 || value > 255)) {
    return {
      title: "RGB to HEX Converter",
      content: "RGB values must be between 0 and 255.",
    };
  }

  const hex = values
    .map((value) => value.toString(16).padStart(2, "0"))
    .join("")
    .toUpperCase();

  return {
    title: "RGB to HEX Converter",
    content: `RGB: rgb(${values.join(", ")})\nHEX: #${hex}`,
  };
};

export const hslColorConverter: ToolHandler = ({ text }) => {
  const clean = text.trim();

  const match = clean.match(
    /^\s*hsl\s*\(\s*(-?\d+(?:\.\d+)?)\s*[, ]\s*(-?\d+(?:\.\d+)?)%?\s*[, ]\s*(-?\d+(?:\.\d+)?)%?\s*\)\s*$/i
  );

  if (!match) {
    return {
      title: "HSL Color Converter",
      content: "Enter HSL in the format hsl(210, 70%, 53%).",
    };
  }

  const h = Number(match[1]);
  const s = Number(match[2]);
  const l = Number(match[3]);

  if (s < 0 || s > 100 || l < 0 || l > 100) {
    return {
      title: "HSL Color Converter",
      content: "Saturation and lightness must be between 0 and 100.",
    };
  }

  const hue = ((h % 360) + 360) % 360;
  const saturation = s / 100;
  const lightness = l / 100;

  const c =
    (1 - Math.abs(2 * lightness - 1)) * saturation;

  const x =
    c * (1 - Math.abs(((hue / 60) % 2) - 1));

  const m = lightness - c / 2;

  let r1 = 0;
  let g1 = 0;
  let b1 = 0;

  if (hue < 60) {
    r1 = c;
    g1 = x;
  } else if (hue < 120) {
    r1 = x;
    g1 = c;
  } else if (hue < 180) {
    g1 = c;
    b1 = x;
  } else if (hue < 240) {
    g1 = x;
    b1 = c;
  } else if (hue < 300) {
    r1 = x;
    b1 = c;
  } else {
    r1 = c;
    b1 = x;
  }

  const r = Math.round((r1 + m) * 255);
  const g = Math.round((g1 + m) * 255);
  const b = Math.round((b1 + m) * 255);

  const hex = [r, g, b]
    .map((value) => value.toString(16).padStart(2, "0"))
    .join("")
    .toUpperCase();

  return {
    title: "HSL Color Converter",
    content: [
      `HSL: hsl(${h}, ${s}%, ${l}%)`,
      `RGB: rgb(${r}, ${g}, ${b})`,
      `HEX: #${hex}`,
    ].join("\n"),
  };
};

export const colorContrastChecker: ToolHandler = ({ text }) => {
  const parts = text
    .split(/\s*(?:vs|versus|,)\s*/i)
    .map((part) => part.trim())
    .filter(Boolean);

  if (parts.length < 2) {
    return {
      title: "Color Contrast Checker",
      content: "Enter two HEX colors, for example #000000 vs #ffffff.",
    };
  }

  const parseHex = (value: string) => {
    const clean = value.replace(/^#/, "");

    if (!/^[0-9a-fA-F]{6}$/.test(clean)) {
      return null;
    }

    return [
      Number.parseInt(clean.slice(0, 2), 16),
      Number.parseInt(clean.slice(2, 4), 16),
      Number.parseInt(clean.slice(4, 6), 16),
    ];
  };

  const first = parseHex(parts[0]);
  const second = parseHex(parts[1]);

  if (!first || !second) {
    return {
      title: "Color Contrast Checker",
      content: "Both colors must be valid 6-digit HEX colors.",
    };
  }

  const luminance = (rgb: number[]) => {
    const channels = rgb.map((value) => {
      const channel = value / 255;
      return channel <= 0.03928
        ? channel / 12.92
        : Math.pow((channel + 0.055) / 1.055, 2.4);
    });

    return (
      0.2126 * channels[0] +
      0.7152 * channels[1] +
      0.0722 * channels[2]
    );
  };

  const l1 = luminance(first);
  const l2 = luminance(second);

  const lighter = Math.max(l1, l2);
  const darker = Math.min(l1, l2);
  const ratio = (lighter + 0.05) / (darker + 0.05);

  const rounded = ratio.toFixed(2);

  const aaNormal = ratio >= 4.5;
  const aaLarge = ratio >= 3;
  const aaaNormal = ratio >= 7;

  return {
    title: "Color Contrast Checker",
    content: [
      `Color 1: #${parts[0].replace(/^#/, "").toUpperCase()}`,
      `Color 2: #${parts[1].replace(/^#/, "").toUpperCase()}`,
      `Contrast ratio: ${rounded}:1`,
      `WCAG AA normal text: ${aaNormal ? "Pass" : "Fail"}`,
      `WCAG AA large text: ${aaLarge ? "Pass" : "Fail"}`,
      `WCAG AAA normal text: ${aaaNormal ? "Pass" : "Fail"}`,
    ].join("\n"),
  };
};

