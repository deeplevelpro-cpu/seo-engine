    return {
      title: "CSV to JSON Converter",
      content: "Please provide CSV data.",
    };
  }

  try {
    const lines = input.split(/\r?\n/).filter(Boolean);
    const headers = lines[0].split(",").map((h) => h.trim());

    const rows = lines.slice(1).map((line) => {
      const values = line.split(",").map((v) => v.trim());

      return Object.fromEntries(
        headers.map((header, index) => [
          header,
          values[index] ?? "",
        ])
      );
    });

    return {
      title: "CSV to JSON Converter",
      content: JSON.stringify(rows, null, 2),
    };
  } catch {
    return {
      title: "CSV to JSON Converter",
      content: "Unable to convert the provided CSV data.",
    };
  }
};

export const jsonToCsvConverter: ToolHandler = ({ text }) => {
  const input = text.trim();

  if (!input) {
    return {
      title: "JSON to CSV Converter",
      content: "Please provide JSON data.",
    };
  }

  try {
    const data = JSON.parse(input);
    const rows = Array.isArray(data) ? data : [data];

    if (!rows.length || typeof rows[0] !== "object" || rows[0] === null) {
      throw new Error("JSON must contain objects.");
    }

    const headers = Array.from(
      new Set(rows.flatMap((row) => Object.keys(row)))
    );

    const escapeCsv = (value: unknown) => {
      const stringValue =
        value === null || value === undefined ? "" : String(value);

      return `"${stringValue.replace(/"/g, '""')}"`;
    };

    const csv = [
      headers.map(escapeCsv).join(","),
      ...rows.map((row) =>
        headers.map((header) => escapeCsv(row[header])).join(",")
      ),
    ].join("\n");

    return {
      title: "JSON to CSV Converter",
      content: csv,
    };
  } catch {
    return {
      title: "JSON to CSV Converter",
      content: "Unable to convert the provided JSON data.",
    };
  }
};

