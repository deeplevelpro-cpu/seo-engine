export const sitemapGenerator: ToolHandler = ({ text }) => {
  const lines = cleanText(text)
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  const baseUrl = (lines.shift() || "https://example.com")
    .replace(/\/+$/, "");

  const urls = lines.length ? lines : ["/"];

  const xml = [
    '<?xml version="1.0" encoding="UTF-8"?>',
    '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">',
    ...urls.map((url) => {
      const fullUrl = url.startsWith("http")
        ? url
        : `${baseUrl}${url.startsWith("/") ? "" : "/"}${url}`;

      return `  <url><loc>${fullUrl}</loc></url>`;
    }),
    "</urlset>",
  ].join("\n");

  return {
    title: "XML Sitemap",
    content: xml,
  };
};

