export const ratioCalculator: ToolHandler = ({ text }) => {
  const input = text.trim();
  const parts = input.split(/[:;,/\s]+/).filter(Boolean);

  if (parts.length !== 2) {
    return {
      title: "Ratio Calculator",
      content: "Provide two numbers.",
    };
  }

  const first = Number(parts[0]);
  const second = Number(parts[1]);

  if (
    !Number.isFinite(first) ||
    !Number.isFinite(second) ||
    second === 0
  ) {
    return {
      title: "Ratio Calculator",
      content: "Please provide valid numbers and a non-zero second value.",
    };
  }

  const divisor = (a: number, b: number): number => {
    let x = Math.abs(a);
    let y = Math.abs(b);

    while (y !== 0) {
      const remainder = x % y;
      x = y;
      y = remainder;
    }

    return x;
  };

  const gcd = divisor(first, second);
  const simplifiedFirst = first / gcd;
  const simplifiedSecond = second / gcd;

  return {
    title: "Ratio Calculator",
    content: `Ratio: ${first}:${second}\nSimplified ratio: ${simplifiedFirst}:${simplifiedSecond}`,
  };
};

