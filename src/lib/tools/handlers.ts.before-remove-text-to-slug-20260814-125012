export const numberToWordsConverter: ToolHandler = ({ text }) => {
  const input = text.trim();
  const number = Number(input);

  if (!input || !Number.isFinite(number) || !Number.isInteger(number)) {
    return {
      title: "Number to Words Converter",
      content: "Please provide a valid integer.",
    };
  }

  const small = [
    "zero", "one", "two", "three", "four", "five",
    "six", "seven", "eight", "nine", "ten",
    "eleven", "twelve", "thirteen", "fourteen", "fifteen",
    "sixteen", "seventeen", "eighteen", "nineteen",
  ];

  const tens = [
    "", "", "twenty", "thirty", "forty",
    "fifty", "sixty", "seventy", "eighty", "ninety",
  ];

  const convert = (n: number): string => {
    if (n < 20) return small[n];
    if (n < 100) {
      return tens[Math.floor(n / 10)] +
        (n % 10 ? `-${small[n % 10]}` : "");
    }
    if (n < 1000) {
      return `${small[Math.floor(n / 100)]} hundred` +
        (n % 100 ? ` ${convert(n % 100)}` : "");
    }
    if (n < 1_000_000) {
      return `${convert(Math.floor(n / 1000))} thousand` +
        (n % 1000 ? ` ${convert(n % 1000)}` : "");
    }
    if (n < 1_000_000_000) {
      return `${convert(Math.floor(n / 1_000_000))} million` +
        (n % 1_000_000 ? ` ${convert(n % 1_000_000)}` : "");
    }

    return `${convert(Math.floor(n / 1_000_000_000))} billion` +
      (n % 1_000_000_000 ? ` ${convert(n % 1_000_000_000)}` : "");
  };

  const result = number < 0
    ? `minus ${convert(Math.abs(number))}`
    : convert(number);

  return {
    title: "Number to Words Converter",
    content: result,
  };
};

export const wordsToNumberConverter: ToolHandler = ({ text }) => {
  const input = text
    .trim()
    .toLowerCase()
    .replace(/-/g, " ");

  if (!input) {
    return {
      title: "Words to Number Converter",
      content: "Please provide a number in words.",
    };
  }

  const values: Record<string, number> = {
    zero: 0,
    one: 1,
    two: 2,
    three: 3,
    four: 4,
    five: 5,
    six: 6,
    seven: 7,
    eight: 8,
    nine: 9,
    ten: 10,
    eleven: 11,
    twelve: 12,
    thirteen: 13,
    fourteen: 14,
    fifteen: 15,
    sixteen: 16,
    seventeen: 17,
    eighteen: 18,
    nineteen: 19,
    twenty: 20,
    thirty: 30,
    forty: 40,
    fifty: 50,
    sixty: 60,
    seventy: 70,
    eighty: 80,
    ninety: 90,
  };

  const scales: Record<string, number> = {
    hundred: 100,
    thousand: 1000,
    million: 1_000_000,
    billion: 1_000_000_000,
  };

  const words = input.split(/\s+/).filter(Boolean);

  let total = 0;
  let current = 0;
  let negative = false;

  for (const word of words) {
    if (word === "minus" || word === "negative") {
      negative = true;
      continue;
    }

    if (word in values) {
      current += values[word];
      continue;
    }

    if (word in scales) {
      const scale = scales[word];

      if (scale === 100) {
        current = Math.max(1, current) * 100;
      } else {
        total += current * scale;
        current = 0;
      }

      continue;
    }

    return {
      title: "Words to Number Converter",
      content: "Unable to convert the provided words.",
    };
  }

  const result = total + current;

  return {
    title: "Words to Number Converter",
    content: String(negative ? -result : result),
  };
};

