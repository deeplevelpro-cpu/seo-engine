export const colorContrastChecker: ToolHandler = ({ text }) => {
  const parts = text
    .split(/\s*(?:vs|versus|,)\s*/i)
    .map((part) => part.trim())
    .filter(Boolean);

  if (parts.length < 2) {
    return {
      title: "Color Contrast Checker",
      content: "Enter two HEX colors, for example #000000 vs #ffffff.",
    };
  }

  const parseHex = (value: string) => {
    const clean = value.replace(/^#/, "");

    if (!/^[0-9a-fA-F]{6}$/.test(clean)) {
      return null;
    }

    return [
      Number.parseInt(clean.slice(0, 2), 16),
      Number.parseInt(clean.slice(2, 4), 16),
      Number.parseInt(clean.slice(4, 6), 16),
    ];
  };

  const first = parseHex(parts[0]);
  const second = parseHex(parts[1]);

  if (!first || !second) {
    return {
      title: "Color Contrast Checker",
      content: "Both colors must be valid 6-digit HEX colors.",
    };
  }

  const luminance = (rgb: number[]) => {
    const channels = rgb.map((value) => {
      const channel = value / 255;
      return channel <= 0.03928
        ? channel / 12.92
        : Math.pow((channel + 0.055) / 1.055, 2.4);
    });

    return (
      0.2126 * channels[0] +
      0.7152 * channels[1] +
      0.0722 * channels[2]
    );
  };

  const l1 = luminance(first);
  const l2 = luminance(second);

  const lighter = Math.max(l1, l2);
  const darker = Math.min(l1, l2);
  const ratio = (lighter + 0.05) / (darker + 0.05);

  const rounded = ratio.toFixed(2);

  const aaNormal = ratio >= 4.5;
  const aaLarge = ratio >= 3;
  const aaaNormal = ratio >= 7;

  return {
    title: "Color Contrast Checker",
    content: [
      `Color 1: #${parts[0].replace(/^#/, "").toUpperCase()}`,
      `Color 2: #${parts[1].replace(/^#/, "").toUpperCase()}`,
      `Contrast ratio: ${rounded}:1`,
      `WCAG AA normal text: ${aaNormal ? "Pass" : "Fail"}`,
      `WCAG AA large text: ${aaLarge ? "Pass" : "Fail"}`,
      `WCAG AAA normal text: ${aaaNormal ? "Pass" : "Fail"}`,
    ].join("\n"),
  };
};



