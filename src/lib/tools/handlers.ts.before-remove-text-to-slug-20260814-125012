export const faqSchemaGenerator: ToolHandler = ({ text }) => {
  const lines = text
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  const questions = [];

  for (let i = 0; i < lines.length; i += 2) {
    const question = lines[i];
    const answer = lines[i + 1];

    if (!question || !answer) continue;

    questions.push({
      "@type": "Question",
      name: question,
      acceptedAnswer: {
        "@type": "Answer",
        text: answer,
      },
    });
  }

  if (questions.length === 0) {
    questions.push({
      "@type": "Question",
      name: "What is this tool?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "This is an example FAQ answer.",
      },
    });
  }

  const schema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: questions,
  };

  return {
    title: "FAQ Schema",
    content: JSON.stringify(schema, null, 2),
  };
};

