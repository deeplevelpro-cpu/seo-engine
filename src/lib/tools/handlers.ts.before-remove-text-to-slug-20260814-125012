export const romanNumeralConverter: ToolHandler = ({ text }) => {
  const input = text.trim().toUpperCase();

  if (!input) {
    return {
      title: "Roman Numeral Converter",
      content: "Please provide a Roman numeral or integer.",
    };
  }

  const romanValues: Record<string, number> = {
    I: 1,
    V: 5,
    X: 10,
    L: 50,
    C: 100,
    D: 500,
    M: 1000,
  };

  if (/^\d+$/.test(input)) {
    const number = Number(input);

    if (!Number.isInteger(number) || number < 1 || number > 3999) {
      return {
        title: "Roman Numeral Converter",
        content: "Please provide an integer between 1 and 3999.",
      };
    }

    const values: Array<[number, string]> = [
      [1000, "M"],
      [900, "CM"],
      [500, "D"],
      [400, "CD"],
      [100, "C"],
      [90, "XC"],
      [50, "L"],
      [40, "XL"],
      [10, "X"],
      [9, "IX"],
      [5, "V"],
      [4, "IV"],
      [1, "I"],
    ];

    let remaining = number;
    let result = "";

    for (const [value, symbol] of values) {
      while (remaining >= value) {
        result += symbol;
        remaining -= value;
      }
    }

    return {
      title: "Roman Numeral Converter",
      content: result,
    };
  }

  if (!/^[IVXLCDM]+$/.test(input)) {
    return {
      title: "Roman Numeral Converter",
      content: "Please provide a valid Roman numeral or integer.",
    };
  }

  let total = 0;

  for (let i = 0; i < input.length; i++) {
    const current = romanValues[input[i]];
    const next = romanValues[input[i + 1]] ?? 0;

    total += current < next ? -current : current;
  }

  return {
    title: "Roman Numeral Converter",
    content: String(total),
  };
};

