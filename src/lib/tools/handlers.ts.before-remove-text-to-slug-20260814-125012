export const aspectRatioCalculator: ToolHandler = ({ text }) => {
  const match = text.match(
    /(\d+(?:\.\d+)?)\s*(?:x|:)\s*(\d+(?:\.\d+)?)/i
  );

  if (!match) {
    return {
      title: "Aspect Ratio Calculator",
      content: "Please enter dimensions such as 1920x1080.",
    };
  }

  const width = Number(match[1]);
  const height = Number(match[2]);

  if (width <= 0 || height <= 0) {
    return {
      title: "Aspect Ratio Calculator",
      content: "Width and height must be greater than zero.",
    };
  }

  const gcd = (a: number, b: number): number => {
    while (b !== 0) {
      const remainder = a % b;
      a = b;
      b = remainder;
    }
    return Math.abs(a);
  };

  const divisor = gcd(Math.round(width), Math.round(height));
  const ratio = `${Math.round(width) / divisor}:${Math.round(height) / divisor}`;

  return {
    title: "Aspect Ratio Calculator",
    content: [
      `Width: ${width}`,
      `Height: ${height}`,
      `Aspect ratio: ${ratio}`,
      `Decimal ratio: ${(width / height).toFixed(4)}`,
    ].join("\n"),
  };
};

