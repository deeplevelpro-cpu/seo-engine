export const timeDifferenceCalculator: ToolHandler = ({ text }) => {
  const input = text.trim();
  const parts = input.split(/[,;\s]+/).filter(Boolean);

  if (parts.length !== 2) {
    return {
      title: "Time Difference Calculator",
      content: "Provide two times in HH:MM format.",
    };
  }

  const parseTime = (value: string) => {
    const match = value.match(/^(\d{1,2}):(\d{2})$/);

    if (!match) return null;

    const hours = Number(match[1]);
    const minutes = Number(match[2]);

    if (
      !Number.isInteger(hours) ||
      !Number.isInteger(minutes) ||
      hours < 0 ||
      hours > 23 ||
      minutes < 0 ||
      minutes > 59
    ) {
      return null;
    }

    return hours * 60 + minutes;
  };

  const first = parseTime(parts[0]);
  const second = parseTime(parts[1]);

  if (first === null || second === null) {
    return {
      title: "Time Difference Calculator",
      content: "Please provide valid times in HH:MM format.",
    };
  }

  const difference = Math.abs(second - first);
  const hours = Math.floor(difference / 60);
  const minutes = difference % 60;

  return {
    title: "Time Difference Calculator",
    content: `Difference between ${parts[0]} and ${parts[1]}: ${hours} hour${hours === 1 ? "" : "s"} ${minutes} minute${minutes === 1 ? "" : "s"}`,
  };
};

