export const compoundInterestCalculator: ToolHandler = ({ text }) => {
  const input = text.trim();
  const parts = input.split(/[,;\s]+/).filter(Boolean);

  if (parts.length !== 4) {
    return {
      title: "Compound Interest Calculator",
      content: "Provide four numbers: principal, annual rate, compounds per year, years.",
    };
  }

  const principal = Number(parts[0]);
  const rate = Number(parts[1]);
  const compounds = Number(parts[2]);
  const years = Number(parts[3]);

  if (
    !Number.isFinite(principal) ||
    !Number.isFinite(rate) ||
    !Number.isFinite(compounds) ||
    !Number.isFinite(years) ||
    principal < 0 ||
    compounds <= 0 ||
    years < 0
  ) {
    return {
      title: "Compound Interest Calculator",
      content: "Please provide valid non-negative values and a positive compounding frequency.",
    };
  }

  const amount =
    principal *
    Math.pow(1 + rate / 100 / compounds, compounds * years);

  const interest = amount - principal;

  return {
    title: "Compound Interest Calculator",
    content: [
      `Principal: ${principal}`,
      `Annual rate: ${rate}%`,
      `Compounds per year: ${compounds}`,
      `Years: ${years}`,
      `Final amount: ${amount.toFixed(2)}`,
      `Compound interest: ${interest.toFixed(2)}`,
    ].join("\n"),
  };
};

export const listRandomizer: ToolHandler = ({ text }) => {
  const input = text.trim();

  if (!input) {
    return {
      title: "List Randomizer",
      content: "Please provide a list with one item per line.",
    };
  }

  const items = input
    .split(/\r?\n/)
    .map((item) => item.trim())
    .filter(Boolean);

  if (!items.length) {
    return {
      title: "List Randomizer",
      content: "Please provide at least one list item.",
    };
  }

  const shuffled = [...items];

  for (let i = shuffled.length - 1; i > 0; i -= 1) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }

  return {
    title: "List Randomizer",
    content: shuffled.join("\n"),
  };
};

